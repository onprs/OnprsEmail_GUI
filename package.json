{
  "name": "onprs-mail-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "面向 Onprs 邮件系统的安全本地桌面客户端",
  "main": "./out/main/index.js",
  "author": "onprs",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test tests/e2e/app.spec.ts tests/e2e/mail-flow.spec.ts",
    "test:e2e:packaged": "npm run dist:dir && playwright test tests/e2e/packaged.spec.ts",
    "icon": "python scripts/generate_icon.py",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tanstack/react-query": "5.102.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "5.1.4",
    "date-fns": "4.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "28.1.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "online.onprs.mail.desktop",
    "productName": "Onprs Mail",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Onprs-Mail-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
