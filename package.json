{
  "name": "onprsemail_gui",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "description": "面向 Onprs 邮件系统的安全本地桌面客户端",
  "main": "./out/main/index.js",
  "author": "onprs",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org/",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:unit && npm run test:renderer",
    "test:unit": "vitest run",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:watch": "vitest",
    "test:watch:renderer": "vitest --config vitest.renderer.config.ts",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:renderer",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:renderer": "vitest run --config vitest.renderer.config.ts --coverage",
    "test:e2e": "npm run build && playwright test tests/e2e/app.spec.ts tests/e2e/mail-flow.spec.ts",
    "test:e2e:packaged": "npm run dist:dir && playwright test tests/e2e/packaged.spec.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "icon": "python scripts/generate_icon.py",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tanstack/react-query": "5.104.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "date-fns": "4.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "28.1.0",
    "lucide-react": "1.34.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "online.onprs.mail.desktop",
    "productName": "Onprs Mail",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Onprs-Mail-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
